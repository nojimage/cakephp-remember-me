{
  "name": "nojimage/cakephp-remember-me",
  "description": "RememberMe authentication adapter plugin for CakePHP",
  "keywords": [
    "auth",
    "authentication",
    "cakephp",
    "cookie",
    "remember-me"
  ],
  "type": "cakephp-plugin",
  "license": ["MIT"],
  "require": {
    "php": ">=8.1",
    "ext-json": "*",
    "cakephp/core": "^5.0",
    "cakephp/orm": "^5.0",
    "cakephp/authentication": "^3.0"
  },
  "require-dev": {
    "cakephp/cakephp": "^5.0",
    "cakephp/cakephp-codesniffer": "^5.1",
    "cakephp/migrations": "^4.6",
    "phpstan/phpstan": "^1.12",
    "phpunit/phpunit": "^10.5.5 || ^11.1.3 || ^12.0.9"
  },
  "autoload": {
    "psr-4": {
      "RememberMe\\": "src"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "RememberMe\\Test\\": "tests",
      "TestApp\\": "tests/test_app/TestApp",
      "Cake\\Test\\": "vendor/cakephp/cakephp/tests"
    }
  },
  "scripts": {
    "check": [
      "@cs-check",
      "@stan",
      "@test"
    ],
    "cs-check": "phpcs -p --extensions=php ./src ./tests",
    "cs-fix": "phpcbf -p --extensions=php ./src ./tests",
    "stan": "phpstan analyse",
    "test": "phpunit --colors=always",
    "update-lowest": "composer update --prefer-lowest --prefer-stable"
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  }
}
